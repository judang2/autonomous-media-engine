# Copy to .env. Never commit .env or local/.
IG_PROVIDER=mock
PLANNER=demo
ENABLE_LIVE=false
ALLOWED_ACTIONS=reply_dm,reply_comment
# Comma-separated numeric IDs for real providers; mock demo friend below.
ALLOWED_USER_IDS=friend-1
MAX_ACTIONS_PER_DAY=3
MIN_ACTION_INTERVAL_SECONDS=1800
STATE_DIR=local

# GPT requires a separately configured API key and accessible Responses model ID.
OPENAI_API_KEY=
OPENAI_MODEL=

# Subscription mode: set PLANNER=codex. No API key required.
CODEX_MODEL=gpt-5.5
CODEX_REASONING_EFFORT=low
# Optional absolute path if codex is not on PATH.
CODEX_EXECUTABLE=
OWNER_USERNAME=

# Official Instagram API with Instagram Login (Business/Creator).
IG_GRAPH_TOKEN=
IG_GRAPH_USER_ID=
# Set the version supported by your Meta app, e.g. v25.0; verify before use.
IG_GRAPH_VERSION=
GRAPH_ENABLE_DM=false

# Unofficial ordinary-account path. Reads can also cause account restrictions.
ACK_PRIVATE_API_RISK=false
IG_SESSION_FILE=local/instagram-session.json
IG_USERNAME=
# Prefer hidden password prompt at login; leave this empty.
IG_PASSWORD=
PRIVATE_ENABLE_FEED=false
